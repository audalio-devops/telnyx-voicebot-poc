# Porta HTTP da aplicação
SERVER_PORT=8087

# Credenciais e IDs Telnyx
TELNYX_API_KEY=KEY_sua_api_key_telnyx
TELNYX_PUBLIC_KEY=sua_chave_publica_ed25519_base64
TELNYX_CONNECTION_ID=3099557255473792623
TELNYX_ACCOUNT_SID=uuid_da_sua_conta_telnyx
TELNYX_ASSISTANT_ID=assistant-6585b0b1-550a-4d7d-948c-eb4e3538e674
TELNYX_DEFAULT_FROM=+551151189636
TELNYX_WEBHOOK_VERIFY_SIGNATURE=true

# URL pública HTTPS base (sem sufixo de rota) usada nos callbacks enviados à Telnyx.
# A aplicação monta automaticamente /webhooks/telnyx/{call-status,recording,conversation} a partir dela.
PUBLIC_BASE_URL=https://integra369.duckdns.org

# Armazenamento de gravações MP3 (local | s3)
RECORDING_STORAGE=local
RECORDING_LOCAL_PATH=./data/recordings
S3_BUCKET=atendente-recordings
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Banco de dados PostgreSQL (compatível com QR369-GCP-PRO)
VA_DB_URL=jdbc:postgresql://localhost:5432/ragdb
VA_DB_USERNAME=dbrag369
VA_DB_PASSWORD=pwd-db

# Segurança da API pública e webhooks de saída
API_AUTH_TOKEN=troque_este_token_bearer
NOTIFY_HMAC_SECRET=troque_este_segredo_hmac

# Parâmetros de chamada, coleta e retenção LGPD
CALL_TIMEOUT_SEC=45
CALL_TIME_LIMIT_SEC=600
COLLECTION_MAX_WAIT_MIN=30
RETENTION_DAYS=90

